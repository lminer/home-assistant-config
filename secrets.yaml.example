
# Use this file to store secrets like usernames and passwords.
# Learn more at https://www.home-assistant.io/docs/configuration/secrets/
some_password: YOUR_PASSWORD_HERE

# FranklinWH account password, referenced by the franklin_wh sensor platform in
# configuration.yaml. This is the password for the FranklinWH mobile app account,
# not anything Home Assistant issues.
franklinwh_password: YOUR_FRANKLINWH_PASSWORD_HERE

# Long-lived access token for Home Assistant's own REST API. Create one from
# your profile page > Security tab > "Create token" at the bottom.
#
# Nothing in this repo's YAML references it -- it exists so tooling and agents
# can call the API directly (read entity states, invoke actions) instead of
# asking a human to click through the UI to test things. Being able to fire a
# script and watch every device's state in one pass is what finally isolated the
# Denon input bug; see the note about duplicate source names in scripts.yaml.
#
# Treat it as a full-access credential: it can do anything your account can.
# Revoke it from the same page if it leaks. secrets.yaml is gitignored, and this
# .example file must only ever contain the placeholder.
HA_TOKEN: YOUR_LONG_LIVED_ACCESS_TOKEN_HERE
